# ===== 晨析 Morning Insight 后端配置示例 =====
# 复制为 .env 并按需修改：cp backend/.env.example backend/.env

# --------------------------------------------------------------------------- #
# 基础
# --------------------------------------------------------------------------- #
# 数据库（默认 SQLite；生产环境建议 PostgreSQL，例如
#   postgresql+psycopg://user:pass@localhost:5432/morning_insight）
DATABASE_URL=sqlite:///./data/morning_insight.db

# JWT 密钥（生产环境务必改成随机长字符串！）
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-random-secret-string

# Token 有效期（小时）
TOKEN_EXPIRE_HOURS=72

# 默认时区（调度器使用）
TIMEZONE=Asia/Shanghai

# 数据目录（SQLite 库、语音音频、导出文件）
DATA_DIR=./data

# --------------------------------------------------------------------------- #
# 功能开关
# --------------------------------------------------------------------------- #
# 是否允许在界面安装插件（插件是本机 Python 代码，公网部署请先了解风险）
PLUGIN_INSTALL_ENABLED=true

# 是否允许自助注册（第一个注册用户始终可注册，并自动成为管理员）
ALLOW_REGISTRATION=true

# 插件目录（默认指向仓库根的 plugins/）
# PLUGIN_DIR=/absolute/path/to/plugins
